<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_ticket_mx.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <t t-set="mx_cfdi" t-value="props.data?.mx_cfdi || order?.mx_cfdi"/>
            <t t-set="partner" t-value="order.getPartner()"/>
            <t t-set="showOnlineInvoiceQr" t-value="order.isMxInvoiceOnline()"/>
            <t t-set="showCfdiQr" t-value="!showOnlineInvoiceQr and order.isToInvoice() and mx_cfdi"/>
            <div class="pos-receipt p-2">
                <t t-if="order.company.logo">
                    <img class="pos-receipt-logo" t-att-src="order.company.logo" alt="Logo"/>
                </t>

                <table style="width:100%;">
                    <tr>
                        <th style="color:black;">
                            <t t-if="mx_cfdi and mx_cfdi.uuid">Factura</t>
                            <t t-else="">Recibo</t>
                        </th>
                        <td></td>
                        <th class="pos-receipt-order-data" t-esc="order.name"/>
                    </tr>

                    <t t-if="mx_cfdi and mx_cfdi.invoice_name">
                        <tr>
                            <td>Serie/Folio: <span t-esc="mx_cfdi.invoice_name"/></td>
                        </tr>
                    </t>

                    <tr style="height:10px;">
                        <td><t t-esc="order.formatDateOrTime('date_order')"/></td>
                        <td></td>
                    </tr>

                    <tr>
                        <td>
                            <strong>Sucursal</strong><br/>
                            <span t-esc="order.config.name"/>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <strong>Cajero</strong><br/>
                            <span t-esc="order.getCashierName()"/>
                        </td>
                    </tr>

                    <tr>
                        <th style="color:black; height:50px" colspan="3" align="center"></th>
                    </tr>

                    <t t-if="mx_cfdi and mx_cfdi.uuid">
                        <tr style="height:35px;">
                            <th colspan="2" style="color:black;">CERTIFICADO CFDI:</th>
                        </tr>
                    </t>

                    <tr style="height:35px;">
                        <th style="color:black;">Receptor:</th>
                    </tr>
                    <tr style="height:15px;">
                        <td style="color:black;">
                            <span t-esc="mx_cfdi?.cliente_nombre || partner?.name || ''"/>
                        </td>
                    </tr>
                    <tr style="height:20px;">
                        <td>
                            <span t-esc="mx_cfdi?.cliente_rfc || partner?.vat || ''"/>
                        </td>
                    </tr>
                    <t t-if="mx_cfdi and mx_cfdi.uso_cfdi">
                        <tr>
                            <th style="color:black;">USO CFDI: <span t-esc="mx_cfdi.uso_cfdi"/></th>
                        </tr>
                    </t>

                    <tr style="height:35px;">
                        <th style="color:black;">EMISOR:</th>
                    </tr>
                    <tr style="height:15px;">
                        <td colspan="2" t-esc="order.company.name"/>
                    </tr>
                    <tr style="height:20px;">
                        <td colspan="2" t-esc="order.company.vat"/>
                    </tr>

                    <tr style="height:35px;">
                        <td style="color:black;" colspan="2"><strong>Expedido en:</strong></td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <t t-if="mx_cfdi and mx_cfdi.expedido_en">
                                <span t-esc="mx_cfdi.expedido_en"/>
                            </t>
                            <t t-else="">
                                <span t-esc="order.config.name"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <th style="color:black; height:0.30cm" colspan="4" align="center"></th>
                    </tr>
                </table>

                <table style="width:100%;">
                    <tr>
                        <th style="color:black;">Cantidad</th>
                        <th style="color:black;" align="center">Descripción</th>
                        <th style="color:black;" align="center">Precio</th>
                        <th style="color:black;">Importe</th>
                    </tr>
                    <tr>
                        <th style="color:black; height:0.30cm" colspan="4" align="center">
                            <hr size="4px" color="black"/>
                        </th>
                    </tr>
                    <tr t-foreach="order.lines" t-as="line" t-key="line.uuid">
                        <t t-if="line.price_unit &gt;= 0">
                            <td align="center"><span t-esc="line.getQuantity()"/></td>
                            <td><span t-esc="line.getFullProductName()"/></td>
                            <td align="right"><span t-esc="formatCurrency(line.price_unit)"/></td>
                            <td align="right"><span t-esc="formatCurrency(line.priceIncl)"/></td>
                        </t>
                    </tr>
                    <tr>
                        <th style="color:black; height:0.20cm" colspan="4" align="center">
                            <hr/>
                        </th>
                    </tr>
                </table>

                <table style="width:100%;">
                    <t t-if="showOnlineInvoiceQr">
                        <tr>
                            <td style="width:100px; padding:10px" rowspan="12" colspan="2" class="barcode col-3">
                                <div class="text-center">
                                    <img alt="Barcode" t-att-src="order.getOnlineInvoiceBarcodeSrc()"/>
                                    <div style="font-size: 9px; line-height: 1.2;" t-esc="order.getOnlineInvoicePortalUrl()"/>
                                </div>
                            </td>
                        </tr>
                    </t>
                    <t t-if="showCfdiQr and mx_cfdi.extra_values and mx_cfdi.extra_values.barcode_src">
                        <tr>
                            <td style="width:100px; padding:10px" rowspan="12" colspan="2" class="barcode col-3">
                                <div class="text-center">
                                    <img alt="Barcode" t-att-src="mx_cfdi.extra_values.barcode_src"/>
                                </div>
                            </td>
                        </tr>
                    </t>
                    <t t-elif="showCfdiQr and mx_cfdi.barcode_src">
                        <tr>
                            <td style="width:100px; padding:10px" rowspan="12" colspan="2" class="barcode col-3">
                                <div class="text-center">
                                    <img alt="Barcode" t-att-src="mx_cfdi.barcode_src"/>
                                </div>
                            </td>
                        </tr>
                    </t>

                    <tr>
                        <td></td>
                        <td style="color:black;">DESCUENTO:</td>
                        <td align="right"><span t-esc="formatCurrency(order.getTotalDiscount())"/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td style="color:black;">SUBTOTAL:</td>
                        <td align="right"><span t-esc="formatCurrency(order.priceExcl)"/></td>
                    </tr>
                    <t t-set="taxTotals" t-value="order.prices.taxDetails"/>
                    <t t-if="taxTotals and taxTotals.has_tax_groups">
                        <t t-foreach="taxTotals.subtotals" t-as="subtotal" t-key="subtotal.name">
                            <t t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id">
                                <tr>
                                    <td></td>
                                    <td><t t-esc="tax_group.group_name"/></td>
                                    <td align="right"><span t-esc="formatCurrency(tax_group.tax_amount_currency)"/></td>
                                </tr>
                            </t>
                        </t>
                    </t>
                    <tr>
                        <td></td>
                        <td colspan="2"><hr/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td style="color:black;">TOTAL:</td>
                        <td style="color:black;" align="right">
                            <span t-esc="order.currencyDisplayPriceIncl"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="color:#FDFEFE;"> </td>
                        <td>Tipo de pago:</td>
                    </tr>
                    <tr t-foreach="paymentLines" t-as="line" t-key="line.uuid">
                        <td></td>
                        <td><t t-esc="line.payment_method_id.name"/></td>
                        <td>
                            <span t-esc="formatCurrency(line.getAmount())" class="pos-receipt-right-align"/>
                        </td>
                    </tr>
                    <tr t-if="order.showChange">
                        <td></td>
                        <td>CAMBIO</td>
                        <td><span t-esc="formatCurrency(order.change)" class="pos-receipt-right-align"/></td>
                    </tr>
                </table>

                <t t-if="mx_cfdi and mx_cfdi.uuid">
                    <div><strong>PUE - Pago en una sola exhibición</strong></div>
                </t>

                <table style="width:100%;">
                    <t t-if="mx_cfdi and mx_cfdi.cantidad_letra">
                        <tr style="height:35px;">
                            <td style="color:black;" colspan="2" align="center">
                                <span t-esc="mx_cfdi.cantidad_letra"/>
                            </td>
                        </tr>
                    </t>

                    <t t-if="mx_cfdi and mx_cfdi.no_cert_sat">
                        <tr style="height:35px;">
                            <th style="font-size: 12px; color:black;">CERTIFICADO SAT:</th>
                            <td style="font-size: 12px;" align="left"><span t-esc="mx_cfdi.no_cert_sat"/></td>
                        </tr>
                    </t>

                    <t t-if="mx_cfdi and mx_cfdi.fecha_certificacion">
                        <tr style="height:35px;">
                            <th style="font-size: 11px; color:black;">FECHA CERTIFICACIÓN:</th>
                            <td style="font-size: 11px;" align="left"><span t-esc="mx_cfdi.fecha_certificacion"/></td>
                        </tr>
                    </t>

                    <t t-if="mx_cfdi and mx_cfdi.uuid">
                        <tr style="height:35px;">
                            <th style="font-size: 12px; color:black;">FOLIO FISCAL:</th>
                        </tr>
                        <tr>
                            <td style="font-size: 11px;" colspan="2"><span t-esc="mx_cfdi.uuid"/></td>
                        </tr>
                    </t>

                    <t t-if="mx_cfdi and mx_cfdi.cadena_digital">
                        <tr style="height:35px;">
                            <th style="color:black; font-size: 12px;">CADENA ORIGINAL:</th>
                        </tr>
                        <tr style="height:80px; word-break:break-all;">
                            <td style="font-size: 10px; word-break:break-all;" colspan="2">
                                <div class="digital-stamp-content">
                                    <span t-esc="mx_cfdi.cadena_digital"/>
                                </div>
                            </td>
                        </tr>
                    </t>

                    <t t-if="mx_cfdi and mx_cfdi.sello_digital_sat">
                        <tr style="height:35px;">
                            <th style="color:black; font-size: 12px;">SELLO SAT:</th>
                        </tr>
                        <tr style="height:80px; word-break:break-all;">
                            <td style="font-size: 10px; word-break:break-all;" colspan="2">
                                <div class="digital-stamp-content">
                                    <span t-esc="mx_cfdi.sello_digital_sat"/>
                                </div>
                            </td>
                        </tr>
                    </t>

                    <t t-if="mx_cfdi and mx_cfdi.sello_digital_cfdi">
                        <tr style="height:35px;">
                            <th style="color:black; font-size: 12px;" colspan="2">SELLO DIGITAL DEL CFDI:</th>
                        </tr>
                        <tr style="height:80px; word-break:break-all;">
                            <td style="font-size: 10px; word-break:break-all;" colspan="2">
                                <span t-esc="mx_cfdi.sello_digital_cfdi"/>
                            </td>
                        </tr>
                    </t>

                    <tr style="height:70px;">
                        <th style="font-size: 10px;" align="center" colspan="2"></th>
                    </tr>

                    <t t-if="mx_cfdi and mx_cfdi.uuid">
                        <tr style="height:35px;">
                            <th style="font-size: 10px;" align="center" colspan="2">
                                Este documento es una representación impresa de un CFDI, los datos que no se muestran, están contenidos en el XML
                            </th>
                        </tr>
                    </t>
                </table>

                <div class="before-footer"/>

                <div t-if="order.config.receipt_footer" class="pos-receipt-center-align pt-3 text-center" style="white-space:pre-line">
                    <t t-esc="order.config.receipt_footer"/>
                </div>

                <div class="after-footer">
                    <t t-foreach="paymentLines" t-as="line" t-key="line.uuid">
                        <t t-if="line.ticket">
                            <div class="pos-payment-terminal-receipt pt-3">
                                <pre t-esc="line.ticket"/>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
