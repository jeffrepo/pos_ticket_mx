<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

  <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

    <!-- Odoo 19: OrderWidget ya no existe en OrderReceipt. Las lineas estan en OrderDisplay. -->
    <xpath expr="//OrderDisplay" position="before">
      <t t-set="mx_cfdi" t-value="props.data?.mx_cfdi || order?.mx_cfdi"/>
      <t t-set="mx_cfdi_pending" t-value="props.data?.mx_cfdi_pending || order?.mx_cfdi_pending"/>

      <t t-if="mx_cfdi">
        <div class="pos-receipt-order-data">
          <div class="text-center">--------------------------------</div>

          <div class="d-flex">
            <span class="fw-bolder">FACTURA</span>
            <span class="ms-auto" t-esc="mx_cfdi.invoice_name"/>
          </div>

          <t t-if="mx_cfdi.folio_ref">
            <div>Folio Ref: <t t-esc="mx_cfdi.folio_ref"/></div>
          </t>

          <div>FECHA DE EMISIÓN: <t t-esc="mx_cfdi.fecha_emision"/></div>
          <div>FECHA DE CERTIFICACIÓN: <t t-esc="mx_cfdi.fecha_certificacion"/></div>

          <t t-if="mx_cfdi.expedido_en">
            <div>EXPEDIDO EN: <t t-esc="mx_cfdi.expedido_en"/></div>
          </t>

          <div class="mt-1 fw-bolder">CLIENTE</div>
          <div><t t-esc="mx_cfdi.cliente_nombre"/></div>
          <div>RFC: <t t-esc="mx_cfdi.cliente_rfc"/></div>
          <t t-if="mx_cfdi.cliente_domicilio">
            <div class="text-break">Domicilio: <t t-esc="mx_cfdi.cliente_domicilio"/></div>
          </t>

          <div class="mt-1">FOLIO FISCAL (UUID):</div>
          <div class="text-break"><t t-esc="mx_cfdi.uuid"/></div>

          <div class="mt-1">N° Certificado SAT: <t t-esc="mx_cfdi.no_cert_sat"/></div>
          <div>CERTIFICADO DEL EMISOR: <t t-esc="mx_cfdi.no_cert_emisor"/></div>

          <div class="text-center">--------------------------------</div>
        </div>
      </t>

      <t t-if="!mx_cfdi and mx_cfdi_pending">
        <div class="pos-receipt-order-data">
          <div class="text-center">--------------------------------</div>
          <div class="text-center">CFDI en proceso... (reimprime cuando esté timbrado)</div>
          <div class="text-center">--------------------------------</div>
        </div>
      </t>
    </xpath>

    <!-- Bloque inferior antes del footer. En el core adjunto existe <div class="before-footer"/>. -->
    <xpath expr="//div[hasclass('before-footer')]" position="before">
      <t t-set="mx_cfdi" t-value="props.data?.mx_cfdi || order?.mx_cfdi"/>
      <t t-if="mx_cfdi">
        <div class="pos-receipt-order-data mt-2">
          <div><strong>OBSERVACIÓN</strong></div>
          <div>CANTIDAD CON LETRA: <t t-esc="mx_cfdi.cantidad_letra"/></div>
          <t t-if="mx_cfdi.forma_pago_cliente">
            <div>Forma de Pago del Cliente: <t t-esc="mx_cfdi.forma_pago_cliente"/></div>
          </t>
          <t t-if="mx_cfdi.metodo_pago">
            <div>Método de Pago: <t t-esc="mx_cfdi.metodo_pago"/></div>
          </t>
          <t t-if="mx_cfdi.uso_cfdi">
            <div>Uso del CFDI: <t t-esc="mx_cfdi.uso_cfdi"/></div>
          </t>
          <t t-if="mx_cfdi.moneda">
            <div>MONEDA: <t t-esc="mx_cfdi.moneda"/></div>
          </t>

          <div class="mt-1 fw-bolder text-center">EFECTOS FISCALES AL PAGO</div>

          <t t-if="mx_cfdi.cadena_digital">
            <div class="fw-bolder mt-1">CADENA DIGITAL:</div>
            <div class="text-break" style="font-size: 9px; line-height: 1.2;">
              <t t-esc="mx_cfdi.cadena_digital"/>
            </div>
          </t>
          <div class="text-center">--------------------------------</div>

          <t t-if="mx_cfdi.sello_digital_cfdi">
            <div class="fw-bolder mt-1">SELLO DIGITAL CFDI:</div>
            <div class="text-break" style="font-size: 9px; line-height: 1.2;">
              <t t-esc="mx_cfdi.sello_digital_cfdi"/>
            </div>
          </t>
          <div class="text-center">--------------------------------</div>

          <t t-if="mx_cfdi.sello_digital_sat">
            <div class="fw-bolder mt-1">SELLO DIGITAL DEL SAT:</div>
            <div class="text-break" style="font-size: 9px; line-height: 1.2;">
              <t t-esc="mx_cfdi.sello_digital_sat"/>
            </div>
          </t>
          <div class="text-center">--------------------------------</div>

          <div class="text-break" style="font-size: 9px; line-height: 1.2;">
            POR ESTE PAGARE ME(NOS) OBLIGO(AMOS) INCONDICIONALMENTE Y SIN PROTESTA A PAGAR A LA
            ORDEN DE HM MAZATLAN LA CANTIDAD
            <span t-esc="formatCurrency(order.priceIncl)"/> (<t t-esc="mx_cfdi.cantidad_letra"/>)
            DE FACTURA <span t-esc="mx_cfdi.invoice_name"/> EN LA CIUDAD DE CULIACAN SINALOA EL DÍA <t t-esc="order.formatDateOrTime('date_order')"/> hrs
            EN CASO DE MORA CAUSARA INTERES MORATORIOS A RAZÓN DEL 7% MENSUAL.
          </div>

          <div class="mt-2">Nombre: <t t-esc="mx_cfdi.cliente_nombre"/></div>
          <div>Domicilio: <t t-esc="mx_cfdi.cliente_domicilio"/></div>
          <div class="mt-2">Firma: </div>

          <div class="text-center">--------------------------------</div>
          <div class="text-center mt-2 fw-bolder">ORIGINAL DEUDOR</div>

          <t t-if="mx_cfdi.extra_values and mx_cfdi.extra_values.barcode_src">
            <div class="text-center">
              <img alt="Barcode" t-att-src="mx_cfdi.extra_values.barcode_src"/>
            </div>
          </t>

          <div class="text-center mt-1" style="font-size: 10px;">
            Este documento es una representación impresa de un CFDI
          </div>

          <div class="text-center">--------------------------------</div>
        </div>
      </t>
    </xpath>

  </t>

</templates>
