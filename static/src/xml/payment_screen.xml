<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_ticket_mx.PaymentScreenOnlineInvoice"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="after">
            <button class="button mx_invoice_online btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg"
                    t-att-class="{ 'highlight active': this.isMxInvoiceOnline() }"
                    t-on-click="toggleMxInvoiceOnline">
                <span>
                    <i class="fa fa-qrcode me-2"/>
                    Factura en línea
                </span>
                <i class="fa me-2" t-attf-class="{{ this.isMxInvoiceOnline() ? 'fa-check-square text-action' : 'fa-square-o' }}"/>
            </button>
        </xpath>
    </t>
</templates>
